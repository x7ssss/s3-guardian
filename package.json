{
  "name": "s3-guardian",
  "version": "2.0.1",
  "description": "Local-first zero-runtime-dependency CLI to scan, quantify, and safely clean up zombie S3 multipart uploads",
  "type": "module",
  "bin": {
    "s3-guardian": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "build:bundle": "esbuild src/cli.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/bundle.cjs",
    "build:sea": "node scripts/build-sea.mjs",
    "prepublishOnly": "npm test && npm run build",
    "test": "vitest run",
    "test:live": "tsx scripts/live-e2e.ts",
    "test:enterprise": "tsx scripts/enterprise-e2e.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "start": "node ./dist/cli.js"
  },
  "keywords": [
    "aws",
    "s3",
    "multipart-upload",
    "finops",
    "cloud-cost",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-organizations": "^3.1136.0",
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/client-sts": "^3.1136.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
