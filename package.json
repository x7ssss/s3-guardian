{
  "name": "s3-guardian",
  "version": "0.2.0",
  "description": "Local-first zero-runtime-dependency CLI to scan, quantify, and safely clean up zombie S3 multipart uploads",
  "type": "module",
  "bin": {
    "s3-guardian": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm test && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "start": "node ./dist/cli.js"
  },
  "keywords": [
    "aws",
    "s3",
    "multipart-upload",
    "finops",
    "cloud-cost",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "aws-sdk-client-mock": "^4.1.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
